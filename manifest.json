{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/Ben1991/CookieBuddy",
  "action": {
    "default_icon": {
      "16": "assets/logo-v2-16.png",
      "32": "assets/logo-v2-32.png",
      "48": "assets/logo-v2-48.png",
      "128": "assets/logo-v2-128.png"
    },
    "default_title": "CookieBuddy",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "assets/logo-v2-16.png",
    "32": "assets/logo-v2-32.png",
    "48": "assets/logo-v2-48.png",
    "128": "assets/logo-v2-128.png"
  }
}
